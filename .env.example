# name.com provider
NAMECOM_ENV=sandbox
NAMECOM_USERNAME=
NAMECOM_TOKEN=
PROOFROOT_DOMAIN=
PROOFROOT_IDENTITY_MODE=namecom-sandbox

# Identity publication / persistent signing
# Public manifest JSON is safe to expose, but it is deployment-specific and generated locally.
PROOFROOT_PUBLIC_MANIFEST_JSON=
# SECRET: map of keyId -> PKCS#8 private key. Never commit this value.
PROOFROOT_SIGNING_KEYS_JSON=
# DNS target used by the `proof.<domain>` CNAME; resolve this from the actual deployment.
PROOFROOT_MANIFEST_TARGET_HOST=
# Public HTTPS URL used in the root TXT locator. Required in sandbox because sandbox DNS does not resolve publicly.
# Example shape only: https://<your-vercel-deployment>/.well-known/proofroot.json
PROOFROOT_MANIFEST_PUBLIC_URL=

# Deployment
DEPLOYMENT_TARGET=vercel

# AI runtime (Groq is the primary deployed provider; keep the key in secrets)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=

# Optional local development fallback; not the deployed hackathon path
LOCAL_MODEL_BASE_URL=

# Protected tool
REFUND_TOOL_MODE=deterministic-simulator
